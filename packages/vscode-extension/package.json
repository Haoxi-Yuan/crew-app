{
  "name": "claude-crew",
  "displayName": "Claude Crew",
  "description": "Human-governed multi-agent orchestration in VS Code for Claude and Codex",
  "version": "0.2.0",
  "publisher": "claude-crew",
  "license": "MIT",
  "icon": "media/icon.png",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claude-crew.openPanel",
        "title": "Open Panel",
        "category": "Claude Crew"
      },
      {
        "command": "claude-crew.startServer",
        "title": "Start Server",
        "category": "Claude Crew"
      },
      {
        "command": "claude-crew.stopServer",
        "title": "Stop Server",
        "category": "Claude Crew"
      },
      {
        "command": "claude-crew.restartServer",
        "title": "Restart Server",
        "category": "Claude Crew"
      },
      {
        "command": "claude-crew.refreshAgents",
        "title": "Refresh Agents",
        "category": "Claude Crew",
        "icon": "$(refresh)"
      },
      {
        "command": "claude-crew.wakeAgent",
        "title": "Wake Agent",
        "category": "Claude Crew"
      },
      {
        "command": "claude-crew.stopAgent",
        "title": "Stop Agent",
        "category": "Claude Crew"
      },
      {
        "command": "claude-crew.wakeAgentFromTree",
        "title": "Wake",
        "category": "Claude Crew",
        "icon": "$(play)"
      },
      {
        "command": "claude-crew.stopAgentFromTree",
        "title": "Stop",
        "category": "Claude Crew",
        "icon": "$(debug-stop)"
      },
      {
        "command": "claude-crew.openAgentChat",
        "title": "Open Chat",
        "category": "Claude Crew",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "claude-crew.attachTerminal",
        "title": "Attach Terminal",
        "category": "Claude Crew",
        "icon": "$(terminal)"
      },
      {
        "command": "claude-crew.refreshProjects",
        "title": "Refresh Projects",
        "category": "Claude Crew",
        "icon": "$(refresh)"
      },
      {
        "command": "claude-crew.openInbox",
        "title": "Open Inbox",
        "category": "Claude Crew",
        "icon": "$(inbox)"
      },
      {
        "command": "claude-crew.respondApproval",
        "title": "Respond Approval",
        "category": "Claude Crew"
      },
      {
        "command": "claude-crew.resolvePeak",
        "title": "Resolve Peak",
        "category": "Claude Crew"
      },
      {
        "command": "claude-crew.deferPeakToAgent",
        "title": "Let Agent Decide",
        "category": "Claude Crew"
      },
      {
        "command": "claude-crew.pausePeak",
        "title": "Pause Peak",
        "category": "Claude Crew"
      },
      {
        "command": "claude-crew.searchMemory",
        "title": "Search Memory",
        "category": "Claude Crew",
        "icon": "$(search)"
      },
      {
        "command": "claude-crew.openMemoryEntry",
        "title": "Open Memory Entry",
        "category": "Claude Crew"
      },
      {
        "command": "claude-crew.openStandard",
        "title": "Open Standard",
        "category": "Claude Crew"
      },
      {
        "command": "claude-crew.editStandard",
        "title": "Edit Standard",
        "category": "Claude Crew"
      },
      {
        "command": "claude-crew.reviewReflection",
        "title": "Review Reflection",
        "category": "Claude Crew"
      },
      {
        "command": "claude-crew.setActiveProject",
        "title": "Set Active Project",
        "category": "Claude Crew"
      },
      {
        "command": "claude-crew.setActiveWorkplace",
        "title": "Set Active Workplace",
        "category": "Claude Crew"
      },
      {
        "command": "claude-crew.openSharedFile",
        "title": "Open Shared File",
        "category": "Claude Crew"
      },
      {
        "command": "claude-crew.configureAgent",
        "title": "Configure Agent",
        "category": "Claude Crew",
        "icon": "$(gear)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claude-crew",
          "title": "Claude Crew",
          "icon": "media/icon-activitybar.svg"
        }
      ]
    },
    "views": {
      "claude-crew": [
        {
          "id": "claude-crew-agents",
          "name": "Agents"
        },
        {
          "id": "claude-crew-projects",
          "name": "Projects"
        },
        {
          "id": "claude-crew-inbox",
          "name": "Inbox"
        },
        {
          "id": "claude-crew-knowledge",
          "name": "Knowledge"
        },
        {
          "id": "claude-crew-shared-files",
          "name": "Shared Files"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "claude-crew.refreshAgents",
          "when": "view == claude-crew-agents",
          "group": "navigation"
        },
        {
          "command": "claude-crew.refreshProjects",
          "when": "view == claude-crew-projects",
          "group": "navigation"
        },
        {
          "command": "claude-crew.openInbox",
          "when": "view == claude-crew-inbox",
          "group": "navigation"
        },
        {
          "command": "claude-crew.searchMemory",
          "when": "view == claude-crew-knowledge",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "claude-crew.wakeAgentFromTree",
          "when": "viewItem =~ /^agent-offline/",
          "group": "inline"
        },
        {
          "command": "claude-crew.stopAgentFromTree",
          "when": "viewItem =~ /^agent-online/",
          "group": "inline"
        },
        {
          "command": "claude-crew.openAgentChat",
          "when": "viewItem =~ /^agent-/",
          "group": "inline"
        },
        {
          "command": "claude-crew.attachTerminal",
          "when": "viewItem == agent-online-claude",
          "group": "inline"
        },
        {
          "command": "claude-crew.wakeAgentFromTree",
          "when": "viewItem =~ /^agent-offline/",
          "group": "1_actions"
        },
        {
          "command": "claude-crew.stopAgentFromTree",
          "when": "viewItem =~ /^agent-online/",
          "group": "1_actions"
        },
        {
          "command": "claude-crew.attachTerminal",
          "when": "viewItem == agent-online-claude",
          "group": "1_actions"
        },
        {
          "command": "claude-crew.configureAgent",
          "when": "viewItem =~ /^agent-/",
          "group": "1_actions"
        },
        {
          "command": "claude-crew.openAgentChat",
          "when": "viewItem =~ /^agent-/",
          "group": "2_navigation"
        },
        {
          "command": "claude-crew.setActiveProject",
          "when": "viewItem == project-item",
          "group": "1_actions"
        },
        {
          "command": "claude-crew.setActiveWorkplace",
          "when": "viewItem == workplace-item",
          "group": "1_actions"
        },
        {
          "command": "claude-crew.respondApproval",
          "when": "viewItem == approval-item",
          "group": "1_actions"
        },
        {
          "command": "claude-crew.resolvePeak",
          "when": "viewItem == peak-item",
          "group": "1_actions"
        },
        {
          "command": "claude-crew.openSharedFile",
          "when": "viewItem == shared-file-item",
          "group": "2_navigation"
        },
        {
          "command": "claude-crew.openStandard",
          "when": "viewItem == standard-item",
          "group": "2_navigation"
        }
      ]
    },
    "configuration": {
      "title": "Claude Crew",
      "properties": {
        "claude-crew.server.port": {
          "type": "number",
          "default": 0,
          "description": "Server port. 0 = auto-select free port (recommended)."
        },
        "claude-crew.server.dataDir": {
          "type": "string",
          "default": "",
          "description": "Data directory for SQLite DB, shared files, etc. Empty = extension globalStorage."
        },
        "claude-crew.server.projectRoot": {
          "type": "string",
          "default": "",
          "description": "Claude Crew project root directory. Empty = auto-detect from extension path."
        },
        "claude-crew.server.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start server when extension activates."
        },
        "claude-crew.debug.nativeSaves": {
          "type": "boolean",
          "default": false,
          "description": "Log native Claude Crew document open/read/write/save operations to the Claude Crew output channel."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:full": "pnpm --filter @claude-crew/server build && pnpm --filter @claude-crew/web-ui build && bash scripts/copy-assets.sh && node esbuild-server.mjs && node esbuild.config.mjs",
    "copy-assets": "bash scripts/copy-assets.sh",
    "watch": "node esbuild.config.mjs --watch",
    "test:build": "node esbuild.config.mjs && node esbuild-test.mjs",
    "test:e2e": "node esbuild.config.mjs && node esbuild-test.mjs && node dist/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.24.0",
    "glob": "^13.0.6",
    "mocha": "^11.7.5",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "ws": "^8.19.0"
  }
}
